---
import { siteCopy, type SiteLang } from '../../data/site/copy';

interface Props {
  lang: SiteLang;
  /** `hero` sits left-aligned in the morning; `final` is centred at midnight. */
  size: 'hero' | 'final';
}

const { lang, size } = Astro.props;
const t = siteCopy[lang].cta.android;
---

<!--
  Beside the App Store badge, the same height and corners so the two read as a pair, but in the
  page's own glass rather than Google Play's badge: the app is not public on Play yet. Opens the
  page's one Android dialog.
-->
<button
  class:list={['android-btn', size]}
  type="button"
  aria-haspopup="dialog"
  aria-controls="android-dialog"
  data-android-open
>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
    <path d="M4 17a8 8 0 0 1 16 0z" fill="currentColor"></path>
    <path
      d="M7.2 6.6 5.6 4.2M16.8 6.6l1.6-2.4"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      fill="none"></path>
    <circle cx="9" cy="12.6" r="1.1" fill="var(--btn-bg)"></circle>
    <circle cx="15" cy="12.6" r="1.1" fill="var(--btn-bg)"></circle>
  </svg>
  <span>{t.button}</span>
</button>

<style>
  .android-btn {
    --btn-bg: rgba(255, 253, 249, 0.62);
    height: 60px;
    box-sizing: border-box;
    padding: 0 22px 0 18px;
    border-radius: 14px;
    border: none;
    background: var(--btn-bg);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--line),
      0 10px 28px -14px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: inherit;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.2s,
      background 0.2s;
  }
  /* At midnight the glass goes dark, like the fields there. */
  .final {
    --btn-bg: rgba(10, 8, 18, 0.55);
  }
  .android-btn:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px var(--line),
      0 18px 40px -14px rgba(0, 0, 0, 0.4);
  }
  .android-btn:active {
    transform: scale(0.97);
  }
  svg {
    flex-shrink: 0;
    display: block;
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .android-btn {
      transition: none;
    }
    .android-btn:hover {
      transform: none;
    }
  }
</style>
