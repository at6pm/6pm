---
import { androidBetaGroupEmail, androidBetaGroupUrl, playTestUrl } from '../../data/site/config';
import { siteCopy, type SiteLang } from '../../data/site/copy';

interface Props {
  lang: SiteLang;
  /** `hero` sits left-aligned in the morning; `final` is centred at midnight. */
  size: 'hero' | 'final';
}

const { lang, size } = Astro.props;
const t = siteCopy[lang].cta.android;
---

<details class:list={['android', size]}>
  <summary>
    <span class="words">{t.open}</span><span class="sym" aria-hidden="true">arrow_forward</span>
  </summary>
  <div class="panel">
    <p class="how">{t.how}</p>
    <p class="same">{t.sameAccount}</p>
    <ol class="steps">
      <li>
        <a class="pill-btn step-btn" href={androidBetaGroupUrl} rel="noopener">{t.group}</a>
        <p class="note">{t.groupNote}</p>
        <p class="link mono">{androidBetaGroupEmail}</p>
      </li>
      <li>
        <a class="pill-btn step-btn" href={playTestUrl} rel="noopener">{t.test}</a>
        <p class="note">{t.testNote}</p>
        <a class="link" href={playTestUrl} rel="noopener">{playTestUrl}</a>
      </li>
      <li>
        <p class="note install">{t.install}</p>
      </li>
    </ol>
    <p class="stay">{t.stay}</p>
  </div>
</details>

<style>
  .android {
    width: 100%;
    max-width: 460px;
    text-align: left;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .words {
    text-decoration: underline;
    text-decoration-color: var(--sun);
    text-underline-offset: 4px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--sun);
  }
  summary .sym {
    flex-shrink: 0;
    font-size: 16px;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .android[open] summary .sym {
    transform: rotate(90deg);
  }
  .final {
    align-self: center;
  }
  .final summary {
    display: flex;
    justify-content: center;
  }
  .panel {
    margin-top: 14px;
    padding: 18px;
    border-radius: 22px;
    border: 0.5px solid var(--line);
    background: var(--glass);
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .final .panel {
    background: rgba(10, 8, 18, 0.78);
    backdrop-filter: none;
  }
  p {
    margin: 0;
  }
  .how,
  .same,
  .stay {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink2);
  }
  .same {
    color: var(--ink);
    font-weight: 600;
  }
  .stay {
    font-size: 13.5px;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--ink);
    font-size: 14.5px;
    font-weight: 600;
  }
  .steps li {
    position: relative;
    padding-left: 38px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    counter-increment: step;
  }
  /* The step's number in a small round chip, level with its button (or its line, for the last). */
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 12px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 0.5px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  .steps li:last-child::before {
    top: -4px;
  }
  .step-btn {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 22px;
    font-size: 15px;
    text-decoration: none;
  }
  .note {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
    color: var(--ink2);
  }
  .install {
    color: var(--ink);
  }
  .link {
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  a.link {
    text-decoration: underline;
    text-decoration-color: var(--sun);
    text-underline-offset: 4px;
  }
  a.link:hover {
    color: var(--sun);
  }
  @media (prefers-reduced-motion: reduce) {
    summary .sym {
      transition: none;
    }
  }
</style>
