---
import {
  appStoreUrl,
  ctaMode,
  playStoreUrl,
  testFlightUrl,
} from '../../data/site/config';
import { siteCopy, type SiteLang } from '../../data/site/copy';

interface Props {
  lang: SiteLang;
  /** `hero` sits left-aligned in the morning; `final` is centred, a touch taller, at midnight. */
  size: 'hero' | 'final';
}

const { lang, size } = Astro.props;
const t = siteCopy[lang].cta;
const id = `email-${size}`;
---

{
  ctaMode === 'store' ? (
    <div class:list={['store', size]}>
      <a class:list={['badge', size]} href={appStoreUrl} aria-label={t.storeLabel}>
        <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
          <path
            fill="#fff"
            d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
          />
        </svg>
        <span class="badge-words">
          <span class="badge-top">{t.badgeTop}</span>
          <span class="badge-name">App Store</span>
        </span>
      </a>
      <a
        class:list={['badge', 'play', size]}
        href={playStoreUrl}
        rel="noopener"
        aria-label={t.android.store}
      >
        <svg viewBox="0 0 40 40" width="32" height="32" aria-hidden="true">
          <path
            fill="#ea4335"
            d="M19.7,19.2L4.3,35.3c0,0,0,0,0,0c0.5,1.7,2.1,3,4,3c0.8,0,1.5-0.2,2.1-0.6l0,0l17.4-9.9L19.7,19.2z"
          />
          <path
            fill="#fbbc04"
            d="M35.3,16.4L35.3,16.4l-7.5-4.3l-8.4,7.4l8.5,8.3l7.5-4.2c1.3-0.7,2.2-2.1,2.2-3.6C37.5,18.5,36.6,17.1,35.3,16.4z"
          />
          <path
            fill="#4285f4"
            d="M4.3,4.7C4.2,5,4.2,5.4,4.2,5.8v28.5c0,0.4,0,0.7,0.1,1.1l16-15.7L4.3,4.7z"
          />
          <path
            fill="#34a853"
            d="M19.8,20l8-7.9L10.5,2.3C9.9,1.9,9.1,1.7,8.3,1.7c-1.9,0-3.6,1.3-4,3c0,0,0,0,0,0L19.8,20z"
          />
        </svg>
        <span class="badge-words">
          <span class="badge-top">{t.android.storeTop}</span>
          <span class="badge-name">Google Play</span>
        </span>
      </a>
    </div>
  ) : (
    <div class:list={['join', size]} data-join>
      <form class="form" novalidate data-join-form>
        <label class="sr-only" for={id}>
          {t.emailLabel}
        </label>
        <input
          id={id}
          type="email"
          name="email"
          autocomplete="email"
          placeholder={t.emailPh}
          required
          data-join-email
        />
        <button class="pill-btn" type="submit">
          {t.wait}
        </button>
      </form>
      <div class="sent" role="status" hidden data-join-sent>
        <span class="sym" aria-hidden="true">
          check_circle
        </span>
        <span data-join-sent-line />
      </div>
      <span class="note" aria-live="polite" data-join-note data-calm={t.note}>
        {t.note}
      </span>
      <a class="beta" href={testFlightUrl} rel="noopener">
        {t.beta}<span class="sym" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  )
}

<style>
  .join {
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .final {
    align-items: center;
    gap: 12px;
  }
  .form {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .form[hidden] {
    display: none;
  }
  /* At midnight the button stays centred when a phone wraps it under the field. */
  .final .form {
    justify-content: center;
  }
  input {
    flex: 1 1 220px;
    min-width: 0;
    height: 54px;
    box-sizing: border-box;
    padding: 0 20px;
    border-radius: 99px;
    border: 0.5px solid var(--line);
    background: var(--glass);
    color: var(--ink);
    font-family: inherit;
    font-size: 16px;
    outline: none;
    backdrop-filter: blur(12px);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  input:focus,
  input:focus-visible {
    border-color: var(--sun);
    box-shadow: 0 0 0 3px rgba(255, 133, 82, 0.28);
    outline: none;
  }
  .final input {
    height: 56px;
    padding: 0 22px;
    background: rgba(10, 8, 18, 0.45);
    backdrop-filter: none;
  }
  button {
    height: 54px;
    padding: 0 24px;
    font-size: 15px;
  }
  .final button {
    height: 56px;
    padding: 0 26px;
  }
  button[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }
  .sent {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 54px;
    font-size: 16px;
  }
  .sent[hidden] {
    display: none;
  }
  .final .sent {
    height: 56px;
    font-size: 17px;
  }
  .sent .sym {
    font-size: 22px;
    color: var(--acc);
  }
  .final .sent .sym {
    color: var(--sun);
  }
  .note {
    font-size: 13.5px;
    padding-left: 20px;
    color: var(--ink2);
  }
  .final .note {
    padding-left: 0;
  }
  .note[data-error] {
    color: var(--error);
  }
  .beta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-left: 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--sun);
    text-underline-offset: 4px;
  }
  .beta:hover {
    color: var(--sun);
  }
  .final .beta {
    align-self: center;
    padding-left: 0;
  }
  .beta .sym {
    font-size: 16px;
    text-decoration: none;
  }
  /* The App Store and Google Play badges side by side; on a narrow phone, stacked full width. */
  .store {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .store.final {
    justify-content: center;
  }
  @media (max-width: 480px) {
    .store {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .store .badge {
      align-self: stretch;
      justify-content: center;
    }
  }
  .badge {
    align-self: flex-start;
    height: 60px;
    box-sizing: border-box;
    padding: 0 24px 0 18px;
    border-radius: 14px;
    background: #000;
    color: #fff;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 11px;
    box-shadow:
      0 0 0 1px #a6a6a6,
      0 10px 28px -10px rgba(0, 0, 0, 0.5);
    font-family: -apple-system, 'SF Pro Display', 'Helvetica Neue', var(--font-text);
    transition:
      transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.2s;
  }
  .badge.final {
    align-self: center;
  }
  .badge:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px #a6a6a6,
      0 18px 40px -12px rgba(0, 0, 0, 0.55);
  }
  .badge:active {
    transform: scale(0.97);
  }
  .badge svg {
    flex-shrink: 0;
    display: block;
  }
  .badge-words {
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1;
  }
  .badge-top {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .badge-name {
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  /* Google Play's badge: the same plate as the App Store's, with Google's own words and lettering. */
  .play {
    padding: 0 22px 0 16px;
    gap: 10px;
    font-family: 'Google Sans', 'Product Sans', Roboto, 'Helvetica Neue', var(--font-text);
  }
  .play .badge-words {
    gap: 2px;
  }
  .play .badge-top {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .play .badge-name {
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
</style>
