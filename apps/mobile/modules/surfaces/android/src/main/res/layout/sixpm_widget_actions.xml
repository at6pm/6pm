<?xml version="1.0" encoding="utf-8"?>
<!-- A postcard with Scan and Quick add (the Today list, My month, Today's receipt): the picture,
     and a tap area over each drawn round (30 dp, 6 dp apart), placed by the padding of
     `sixpm_widget_actions` at the first one's top left. A button not drawn is gone. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <ImageView
    android:id="@+id/sixpm_widget_picture"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="fitXY" />
  <FrameLayout
    android:id="@+id/sixpm_widget_actions"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="30dp"
      android:orientation="horizontal">
      <FrameLayout
        android:id="@+id/sixpm_widget_scan"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp" />
      <FrameLayout
        android:id="@+id/sixpm_widget_add"
        android:layout_width="30dp"
        android:layout_height="match_parent" />
    </LinearLayout>
  </FrameLayout>
</FrameLayout>
